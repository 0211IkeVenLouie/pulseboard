# Postgres connection string. Fly.io and Railway inject this for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pulseboard
PORT=3000
# Set to false to skip creating the one-click demo board on boot.
SEED_DEMO=true
# Postgres schema to keep this app's tables in. Leave unset for `public`.
# Set it when several apps share one database (Render's free tier allows only
# one), so their tables and migration history stay separate.
DB_SCHEMA=pulseboard
