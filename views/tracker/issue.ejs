<%- include('../partials/head', { title: issue.key + ' — ' + issue.title }) %>
<%- include('../partials/app-shell', { active: active }) %>
<main class="wrap page">
  <p class="small muted" style="margin-bottom: 10px;">
    <a class="back-link" href="<%= returnTo %>">← Back</a>
    <span class="faint">·</span>
    <a href="/projects/<%= project.key %>/board"><%= project.name %></a>
    <span class="faint">/</span>
    <span class="ikey"><%= issue.key %></span>
  </p>
  <% if (error) { %><div class="notice"><%= error %></div><% } %>

  <div class="issue-layout">
    <!-- ------------------------------------------------------ main column -->
    <div>
      <form method="post" action="/projects/<%= project.key %>/issues/<%= issue.number %>" id="details-form">
        <input type="hidden" name="version" value="<%= issue.version %>" />
        <input type="hidden" name="returnTo" value="<%= returnTo %>" />
        <input type="hidden" name="stay" value="1" />

        <input class="issue-title-input" type="text" name="title" value="<%= issue.title %>"
               maxlength="200" required aria-label="Issue title" />

        <h2 class="block-label">Description</h2>
        <textarea name="description" rows="8" class="issue-description"
                  placeholder="What is the problem, and how would you know it is fixed?"><%= issue.description %></textarea>

        <div class="row" style="margin-top: 12px;">
          <button class="btn btn-primary" type="submit">Save</button>
          <a class="btn" href="<%= returnTo %>">Cancel</a>
        </div>
      </form>

      <!-- ------------------------------------------------------- comments -->
      <section id="comments" class="section">
        <h2 class="block-label">
          Comments
          <% if (comments.length) { %><span class="count-pill"><%= comments.length %></span><% } %>
        </h2>

        <% if (comments.length === 0) { %>
          <p class="muted small">No comments yet. Say what you found, or what you decided.</p>
        <% } else { %>
          <ol class="comment-list">
            <% comments.forEach(function (comment) { %>
              <li class="comment" id="c-<%= comment.id %>">
                <span class="mini-avatar" title="<%= comment.authorName %>"><%= initialsOf(comment.authorName) %></span>
                <div class="comment-body">
                  <p class="comment-meta">
                    <strong><%= comment.authorName %></strong>
                    <time datetime="<%= comment.createdAt.toISOString() %>" title="<%= absoluteTime(comment.createdAt) %>">
                      <%= relativeTime(comment.createdAt) %>
                    </time>
                    <% if (comment.editedAt) { %><span class="faint">· edited</span><% } %>
                  </p>

                  <% if (editingComment === comment.id) { %>
                    <form method="post" action="/projects/<%= project.key %>/issues/<%= issue.number %>/comments/<%= comment.id %>">
                      <textarea name="body" rows="4" required autofocus><%= comment.body %></textarea>
                      <div class="row" style="margin-top: 8px;">
                        <button class="btn btn-sm btn-primary" type="submit">Save comment</button>
                        <a class="btn btn-sm" href="/projects/<%= project.key %>/issues/<%= issue.number %>#c-<%= comment.id %>">Cancel</a>
                      </div>
                    </form>
                  <% } else { %>
                    <div class="comment-text"><%= comment.body %></div>
                    <% if (user && comment.authorId === user.id) { %>
                      <p class="comment-actions">
                        <a href="/projects/<%= project.key %>/issues/<%= issue.number %>?edit=<%= comment.id %>#c-<%= comment.id %>">Edit</a>
                        <span class="faint">·</span>
                        <form method="post"
                              action="/projects/<%= project.key %>/issues/<%= issue.number %>/comments/<%= comment.id %>"
                              onsubmit="return confirm('Delete this comment?');">
                          <input type="hidden" name="action" value="delete" />
                          <button class="link-button" type="submit">Delete</button>
                        </form>
                      </p>
                    <% } %>
                  <% } %>
                </div>
              </li>
            <% }) %>
          </ol>
        <% } %>

        <form method="post" action="/projects/<%= project.key %>/issues/<%= issue.number %>/comments"
              class="comment-form">
          <input type="hidden" name="returnTo" value="<%= returnTo %>" />
          <span class="mini-avatar"><%= initialsOf(user.name) %></span>
          <div style="flex: 1;">
            <textarea name="body" rows="3" placeholder="Add a comment…" required maxlength="4000"></textarea>
            <div class="row" style="margin-top: 8px;">
              <button class="btn btn-sm btn-primary" type="submit">Comment</button>
            </div>
          </div>
        </form>
      </section>
    </div>

    <!-- ---------------------------------------------------------- sidebar -->
    <aside>
      <form method="post" action="/projects/<%= project.key %>/issues/<%= issue.number %>" class="card side-card">
        <input type="hidden" name="version" value="<%= issue.version %>" />
        <input type="hidden" name="returnTo" value="<%= returnTo %>" />

        <div class="field">
          <label for="status">Status</label>
          <select id="status" name="status">
            <% ALL_STATUSES.forEach(function (s) { %>
              <option value="<%= s %>" <%= issue.status === s ? 'selected' : '' %>><%= STATUS_LABELS[s] %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="assigneeId">Assignee</label>
          <select id="assigneeId" name="assigneeId">
            <option value="">Unassigned</option>
            <% members.forEach(function (m) { %>
              <option value="<%= m.id %>" <%= issue.assigneeId === m.id ? 'selected' : '' %>><%= m.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="type">Type</label>
          <select id="type" name="type">
            <% ['task','bug','story'].forEach(function (t) { %>
              <option value="<%= t %>" <%= issue.type === t ? 'selected' : '' %>><%= TYPE_LABELS[t] %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="priority">Priority</label>
          <select id="priority" name="priority">
            <% ['low','medium','high','urgent'].forEach(function (p) { %>
              <option value="<%= p %>" <%= issue.priority === p ? 'selected' : '' %>><%= PRIORITY_LABELS[p] %></option>
            <% }) %>
          </select>
        </div>
        <button class="btn btn-primary" type="submit" style="width: 100%;">Update fields</button>
      </form>

      <dl class="side-meta">
        <dt>Reporter</dt><dd><%= issue.reporterName || 'Unknown' %></dd>
        <dt>Updated</dt>
        <dd><time title="<%= absoluteTime(issue.updatedAt) %>"><%= relativeTime(issue.updatedAt) %></time></dd>
      </dl>

      <form method="post" action="/projects/<%= project.key %>/issues/<%= issue.number %>/delete"
            onsubmit="return confirm('Delete <%= issue.key %>? This cannot be undone.');">
        <input type="hidden" name="returnTo" value="<%= returnTo %>" />
        <button class="btn btn-sm btn-ghost" type="submit">Delete issue</button>
      </form>
    </aside>
  </div>
</main>
<div class="toasts" id="toasts"></div>
<script src="/saved-toast.js" type="module"></script>
</body></html>
