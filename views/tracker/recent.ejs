<%- include('../partials/head', { title: 'Recent — Pulseboard' }) %>
<%- include('../partials/app-shell', { active: active }) %>
<main class="wrap page narrow">
  <div class="page-head">
    <h1>Recent</h1>
    <span class="spacer"></span>
    <% if (items.length) { %>
      <form method="post" action="/recent/clear"
            onsubmit="return confirm('Clear your recent list? Nothing is deleted — it only stops showing here.');">
        <button class="btn btn-sm btn-ghost" type="submit">Clear all</button>
      </form>
    <% } %>
  </div>
  <% if (items.length === 0) { %>
    <div class="empty"><strong>Nothing here yet.</strong> Projects, boards and issues you open are listed here, newest first.</div>
  <% } else { %>
    <div class="rows">
      <% items.forEach(function (item) { %>
        <%- include('../partials/bookmark-row', {
              item: item, dismiss: '/recent/dismiss', dismissLabel: 'Remove from Recent', returnTo: '/recent',
            }) %>
      <% }) %>
    </div>
  <% } %>
</main>
<div class="toasts" id="toasts"></div>
<script src="/saved-toast.js?v=<%= assetVersion %>" type="module"></script>
</body></html>
