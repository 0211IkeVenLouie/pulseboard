<%- include('../partials/head', { title: 'Starred — Pulseboard' }) %>
<%- include('../partials/app-shell', { active: active }) %>
<main class="wrap page narrow">
  <div class="page-head"><h1>Starred</h1></div>
  <% if (items.length === 0) { %>
    <div class="empty">
      <strong>Nothing starred.</strong>
      Star a project or a board and it stays here, so you never have to hunt for the link again.
    </div>
  <% } else { %>
    <div class="rows">
      <% items.forEach(function (item) { %>
        <%- include('../partials/bookmark-row', {
              item: item, dismiss: '/starred/remove', dismissLabel: 'Unstar', returnTo: '/starred',
            }) %>
      <% }) %>
    </div>
  <% } %>
</main>
<div class="toasts" id="toasts"></div>
<script src="/saved-toast.js?v=<%= assetVersion %>" type="module"></script>
</body></html>
